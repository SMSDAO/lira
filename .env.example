# LIRA Protocol Environment Configuration
# Copy this file to `.env.local` for local development, or configure the same values in Vercel.
#
# Production note:
# - Do not commit real secrets.
# - Only NEXT_PUBLIC_* variables are safe to expose in the browser.
# - DATABASE_URL, JWT_SECRET, SESSION_SECRET, and NEXT_PUBLIC_WALLET_CONNECT_ID are required in production.
# - Contract addresses can remain as NOT_DEPLOYED during UI-only development, but real values are required before production deploy.

# Base network defaults
NEXT_PUBLIC_CHAIN_ID=8453
NEXT_PUBLIC_CHAIN_NAME=base
NEXT_PUBLIC_RPC_BASE_MAINNET=https://mainnet.base.org
NEXT_PUBLIC_RPC_BASE_SEPOLIA=https://sepolia.base.org

# Public contract addresses. Keep these as NOT_DEPLOYED when the contract set is not yet deployed.
NEXT_PUBLIC_LIRA_TOKEN=NOT_DEPLOYED
NEXT_PUBLIC_LIRA_REGISTRY=NOT_DEPLOYED
NEXT_PUBLIC_LIRA_PROFILE=NOT_DEPLOYED
NEXT_PUBLIC_LIRA_SOCIAL_GRAPH=NOT_DEPLOYED
NEXT_PUBLIC_FACTORY=NOT_DEPLOYED
NEXT_PUBLIC_USER_FACTORY=NOT_DEPLOYED
NEXT_PUBLIC_ADMIN_WALLET=0x0000000000000000000000000000000000000000

# Local API endpoints
NEXT_PUBLIC_API_URL=http://localhost:3000/api
NEXT_PUBLIC_GO_API_URL=http://localhost:8080
NEXT_PUBLIC_JAVA_API_URL=http://localhost:8081

# Database (required in production)
# Example local Postgres: postgresql://postgres:postgres@localhost:5432/lira
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lira
DB_HOST=localhost
DB_PORT=5432
DB_NAME=lira
DB_USER=postgres
DB_PASSWORD=postgres

# WalletConnect (required for wallet login)
# Get a project ID from: https://cloud.walletconnect.com/
NEXT_PUBLIC_WALLET_CONNECT_ID=replace_with_walletconnect_project_id

# Auth / session secrets (required in production)
JWT_SECRET=change_me_32_chars_minimum
SESSION_SECRET=change_me_32_chars_minimum

# Optional Redis / cache
REDIS_URL=redis://localhost:6379

# Optional cloud storage
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET=lira-uploads

# Admin access list (comma-separated wallet addresses)
ADMIN_ADDRESSES=0x0000000000000000000000000000000000000000
DEV_ADDRESSES=

# Protocol defaults
DEFAULT_PROTOCOL_FEE=100
DEFAULT_CREATOR_FEE=200
DEFAULT_LAUNCH_FEE=0.01

# Quantum / indexing settings
QUANTUM_SIMULATOR=true
QUANTUM_BACKEND=local
INDEXER_NETWORK=base-sepolia
INDEXER_POLL_INTERVAL=5000
INDEXER_BATCH_SIZE=1000
INDEXER_RETRY_ATTEMPTS=3
INDEXER_LOG_LEVEL=info
START_BLOCK_BASE_SEPOLIA=0
START_BLOCK_BASE_MAINNET=0

# Logging / rate limiting
LOG_LEVEL=info
LOG_FILE=logs/lira.log
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX_REQUESTS=100
CORS_ORIGIN=http://localhost:3000

# Feature flags
ENABLE_QUANTUM_ORACLE=true
ENABLE_SOCIAL_FEATURES=true
ENABLE_AUTO_LAUNCH=true
ENABLE_AGENT_EXECUTION=true

# Node environment
NODE_ENV=development
